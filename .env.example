# =====================================================================
# EndzoneIQ environment template. Copy to .env.local for development.
# Production: set these in hPanel (Node.js app > Environment variables),
# NEVER in GitHub. NEXT_PUBLIC_* values are baked in at build time, so
# they must ALSO be set as GitHub Actions variables.
# =====================================================================

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local: docker compose up -d   (production: localhost/127.0.0.1 on Hostinger)
DATABASE_URL=mysql://endzoneiq:endzoneiq@127.0.0.1:3306/endzoneiq
# Integration tests (npm test) use a separate database: picks are append-only, so the
# tests reset it. docker compose creates it on first start (docker/initdb). For an
# existing volume: docker exec endzoneiq-db mariadb -uroot -pendzoneiq-root < docker/initdb/01-test-db.sql
TEST_DATABASE_URL=mysql://endzoneiq:endzoneiq@127.0.0.1:3306/endzoneiq_test

# --- Auth (Phase 5) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI (Phase 3/6). Model names come from env, never hardcoded ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL_CHAT=
CLAUDE_MODEL_FAST=
# Assistant questions per UTC day (defaults: 3 free, 50 Pro)
CHAT_LIMIT_FREE=3
CHAT_LIMIT_PRO=50

# --- Payments (Phase 5) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_SEASON=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email (Phase 5/7) ---
RESEND_API_KEY=
EMAIL_FROM=hello@endzoneiq.com

# --- Internal API (Phase 1) and cron (Phase 7). Generate with: openssl rand -hex 32 ---
INGEST_SECRET=
CRON_SECRET=

# --- Admin re-predict dispatch (Phase 7): fine-grained token, this repo's Actions only ---
GITHUB_TOKEN=
GITHUB_REPO=owner/endzoneiq

# --- Web push (Phase 7): npx web-push generate-vapid-keys ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Analytics & errors (Phase 8) ---
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=

ADMIN_EMAILS=
FEATURE_ODDS=false

# Escape hatch: start without running migrations (see docs/deployment.md)
SKIP_MIGRATIONS=false
